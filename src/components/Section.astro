---
import { cn } from '@/utils'

const { class: className, title } = Astro.props
---

<section class={cn(className, 'flex flex-col gap-y-5 md:flex-row md:gap-y-0')}>
	<div class='md:w-1/3'>
		<div class='sticky top-8 flex flex-col gap-y-2'>
			<h2 class='text-lg font-medium uppercase tracking-[0.18em] text-accent'>
				{title}
			</h2>
			<div class='h-px w-10 bg-accent/60'></div>
		</div>
	</div>
	<div class='flex flex-col gap-y-6 md:w-2/3'>
		<slot />
	</div>
</section>
